<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SignSphere"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btn_text_to_sign"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="Text →\nSign"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/widget_button_bg"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_sign_to_text"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="Sign →\nText"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/widget_button_bg"
            android:textAllCaps="false" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btn_voice_to_sign"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="Voice →\nSign"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/widget_button_bg"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_sign_to_voice"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="Sign →\nVoice"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/widget_button_bg"
            android:textAllCaps="false" />
    </LinearLayout>

</LinearLayout>
