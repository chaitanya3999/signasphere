<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background_emergency">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🚨 Emergency"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btn_call_police"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="🚔\nPolice\n100"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/widget_button_emergency"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_call_ambulance"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="🚑\nAmbu.\n108"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/widget_button_emergency"
            android:textAllCaps="false" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btn_call_fire"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="🚒\nFire\n101"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/widget_button_emergency"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_sos_message"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:text="📩\nSOS\nMessage"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/widget_button_sos"
            android:textAllCaps="false" />
    </LinearLayout>

</LinearLayout>
